{
  "compilerOptions": {
    "allowJs": true,
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM"],
    "types": ["vite/client"]
  },
  "include": [
    "src",
    "packages/controlPanel/components/ControlPanel.vue",
    "packages/controlPanel/pages/RaceTrack.vue",
    "animejs.d.ts"
  ],
  "exclude": ["node_modules"]
}
